---
import Layout from '../../layouts/Layout.astro';
import {articles} from '../../data/content';
import {articleLabels} from '../../data/ui-labels';
import EditorialNote from '../../components/seo/EditorialNote.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article:a}=Astro.props;
const title = articleLabels[a.slug] ?? a.title;
const updated='updated' in a?a.updated:'2026-09-21';
const related=articles.filter(b=>b.slug!==a.slug).filter(b=>['resume-summary','skills-to-put-on-resume','resume-length','resume-keywords','first-resume'].includes(b.slug)).slice(0,3);
const schema=[{'@type':'Article',headline:a.title,description:a.intro,dateModified:updated,author:{'@id':'https://resumv.com/#organization'},publisher:{'@id':'https://resumv.com/#organization'},mainEntityOfPage:`https://resumv.com/advice/${a.slug}/`}];
---
<Layout title={title} description={`英文求职指南：${title}`} schema={schema} active="advice"><article class="page-wrap article guide-body">
<Breadcrumbs items={[{name:'求职指南',url:'/advice/'},{name:title}]}/>
<header class="page-heading"><span class="eyebrow">英文指南</span><h1>{title}</h1><span class="card-tag">{Math.max(2,Math.ceil((a.intro+' '+a.sections.flat().join(' ')).split(/\s+/).length/200))} 分钟阅读</span></header>
<p class="guide-answer" lang="en">{a.intro}</p>
<nav class="guide-toc" aria-label="本页目录"><strong>本页目录</strong><ol lang="en">{a.sections.map(([heading],i)=><li><a href={`#section-${i+1}`}>{heading}</a></li>)}</ol></nav>
{a.sections.map(([heading,text],i)=><section lang="en"><h2 id={`section-${i+1}`}>{heading}</h2><p>{text}</p></section>)}
{a.slug==='resume-summary'&&<div class="seo-actions"><a class="button primary" href="/tools/resume-summary-generator/">根据经历起草个人简介 ↗</a></div>}
<section class="guide-related"><h2>使用工具修改简历</h2><div class="topic-links"><a href="/builder/?new=1">打开简历编辑器</a><a href="/templates/">选择简历模板</a>{related.map(b=><a href={`/advice/${b.slug}/`}>{articleLabels[b.slug] ?? b.title}</a>)}</div></section>
<section><h2>参考资料与延伸阅读</h2><p>下列独立资料提供一般背景。Resumv 的文字和虚构示例为原创教学材料，相关机构未对本站内容作出背书。</p><ul class="source-list"><li><a href="https://cloudfront.careeronestop.org/JobSearch/Resumes/ResumeGuide/formatting.aspx">CareerOneStop · 简历格式</a></li><li><a href="https://cloudfront.careeronestop.org/JobSearch/Resumes/ResumeGuide/work-experience.aspx">CareerOneStop · 工作经历</a></li><li><a href="https://cloudfront.careeronestop.org/JobSearch/Resumes/ResumeGuide/education.aspx">CareerOneStop · 教育经历</a></li></ul></section>
<EditorialNote updated={updated}/>
</article></Layout>
