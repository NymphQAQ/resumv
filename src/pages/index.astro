---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ResumePreview from '../components/ResumePreview.astro';
import {reactiveTemplates} from '../data/templates';
---
<Layout title="简历模板、示例与免费求职工具" description="使用免费模板、岗位示例和写作指南制作简历。在浏览器中编辑并下载 PDF 或 Word 文件。"><div class="home-wrap">
<div class="page-kicker"><span class="live-dot"></span> 免费在线简历工具</div>
<section class="hero"><div class="hero-copy"><h1>把你的经历<br/><span>写成一份好简历</span></h1><p>选一个模板，填入真实经历，随时预览并下载简历。</p><div class="hero-buttons"><a class="button primary" href="/builder/">创建我的简历 <Icon name="arrow"/></a><a class="button secondary" href="/templates/">浏览模板</a></div><div class="hero-facts"><span>✓ 免费使用</span><span>✓ 无需注册</span></div></div><div class="hero-art"><div class="hero-outline"></div><div class="hero-resume"><ResumePreview/></div><div class="float-note note-top"><span class="spark-box">✦</span><div><strong>在线编辑</strong><small>随时预览</small></div></div><div class="float-note note-bottom"><span class="check-disc">✓</span><div><strong>简历可下载</strong><small>支持 PDF 和 Word</small></div></div><span class="art-star star-one">✳</span><span class="art-star star-two">✦</span></div></section>
<div class="benefit-strip"><span><Icon name="check"/> 清晰易读的模板</span><span><Icon name="spark"/> 简历写作指南</span><span><Icon name="download"/> 支持 PDF、Word 和 JSON</span><span><Icon name="folder"/> 文档保存在本地</span></div>
<section class="section templates-section"><div class="section-heading"><div><h2>简历模板</h2></div><a class="text-link" href="/templates/">全部模板 <Icon name="arrow"/></a></div><div class="filter-row" data-home-filters><button class="filter active" data-filter="all">推荐</button><button class="filter" data-filter="professional">专业</button><button class="filter" data-filter="modern">现代</button><button class="filter" data-filter="creative">创意</button><button class="filter" data-filter="simple">简约</button></div><div class="template-grid home-templates">{['onyx','azurill','chikorita','ditto'].map((id,i)=>{const t=reactiveTemplates.find(t=>t.id===id)!;return <a href={`/builder/?template=${t.id}`} class="template-card" data-category={t.category}><div class:list={['template-stage',`stage-${t.id}`]}>{i===0&&<span class="template-badge">REACTIVE RESUME</span>}<img class="upstream-preview" src={`/templates/${t.id}.jpg`} alt={`${t.name} 简历模板`} loading="lazy" width="600" height="848"/><span class="template-use">使用此模板 ↗</span></div><div class="template-caption"><div><h3>{t.name}</h3><p>{t.description}</p></div></div></a>;})}</div></section>
<section class="tool-banner"><div><h2>求职工具</h2></div><a href="/cover-letter/"><Icon name="mail"/><strong>求职信编辑器</strong><span>撰写和下载求职信 ↗</span></a><a href="/checker/"><Icon name="check"/><strong>简历检查</strong><span>检查简历内容与关键词 ↗</span></a></section>
<section class="section"><div class="section-heading"><div><h2>三步制作简历</h2></div><a class="text-link" href="/builder/">开始制作 <Icon name="arrow"/></a></div><div class="steps-grid">{[['01','选择模板','按目标岗位和偏好选择版式。'],['02','填写经历','整理工作、教育和项目经历，写下可验证的成果。'],['03','下载简历','检查每页预览，再下载投递所需的格式。']].map(([n,title,desc])=><div><span class="step-number">{n}</span><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
<section class="section"><h2>按岗位或写作问题查找</h2><div class="topic-links"><a href="/resume-builder/">免费在线简历编辑器</a><a href="/templates/finance/">金融简历模板</a><a href="/templates/registered-nurse/">护士简历模板</a><a href="/advice/skills-to-put-on-resume/">简历该写哪些技能</a><a href="/advice/resume-length/">简历写几页合适？</a><a href="/advice/">简历指南</a></div></section><section class="home-bottom"><h2>开始制作你的简历</h2><a class="button primary" href="/builder/">创建简历 <Icon name="arrow"/></a></section><footer class="footer"><span>© {new Date().getFullYear()} resumv</span></footer>
</div></Layout>
