---
import Layout from '../../layouts/Layout.astro';
import EditorialNote from '../../components/seo/EditorialNote.astro';
---
<Layout title="免费个人简介生成器 · 无需注册" description="将岗位方向、技能及真实成果整理成可编辑的个人简介。工具免费，在浏览器内运行，无需注册。"><div class="page-wrap article"><header class="page-heading"><span class="eyebrow">简历写作工具</span><h1>个人简介生成器</h1><p>填写真实经历，工具会在浏览器中把它们整理成简短草稿。</p></header><form id="summary-form" class="summary-form"><label class="field-label">职业方向<input class="field" id="summary-role" required maxlength="100" placeholder="数据分析师"/></label><label class="field-label">相关技能<input class="field" id="summary-skills" required maxlength="250" placeholder="SQL、Python 和运营报表"/></label><label class="field-label">一项真实成果<textarea class="field" id="summary-evidence" required maxlength="500" rows="3" placeholder="将周报自动化，每月为团队节省 12 小时"></textarea></label><label><input type="checkbox" id="summary-starter"/> 我刚进入这个领域，请着重描述求职目标。</label><button class="button primary" type="submit">生成简介草稿</button></form><section class="seo-section"><h2>可编辑草稿</h2><textarea id="summary-result" class="field summary-result" rows="5" aria-label="生成的简介" placeholder="草稿将在这里显示。"></textarea><div class="seo-actions"><button id="copy-summary" class="button secondary" disabled>复制简介</button><a class="button primary" href="/builder/">打开简历编辑器 ↗</a></div><p id="summary-status" role="status" class="hint"></p><p>逐句核对后，可复制到编辑器的「个人简介」章节。输入内容仅用于当前页面的本地处理。</p></section><section class="seo-section"><h2>怎样写好个人简介？</h2><p>明确职业方向，选出与目标岗位相关的技能，并给出自己能具体说明的成果。转行时，可分别写清已有经历和求职目标。</p><div class="topic-links"><a href="/advice/resume-summary/">个人简介示例与写法</a></div></section><EditorialNote/></div></Layout>
<script>
import {draftSummary} from '../../lib/summary-generator';
const form=document.querySelector<HTMLFormElement>('#summary-form')!;
const result=document.querySelector<HTMLTextAreaElement>('#summary-result')!;
const copy=document.querySelector<HTMLButtonElement>('#copy-summary')!;
const status=document.querySelector<HTMLElement>('#summary-status')!;
form.addEventListener('submit',e=>{e.preventDefault();try{result.value=draftSummary((document.querySelector('#summary-role') as HTMLInputElement).value,(document.querySelector('#summary-skills') as HTMLInputElement).value,(document.querySelector('#summary-evidence') as HTMLTextAreaElement).value,(document.querySelector('#summary-starter') as HTMLInputElement).checked,'zh-CN');copy.disabled=false;status.textContent='草稿已生成，请根据真实经历和目标岗位修改。';}catch(e){status.textContent=e instanceof Error ? e.message : '无法生成草稿，请检查表单内容。';}});
result.addEventListener('input',()=>copy.disabled=!result.value.trim());
copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(result.value);status.textContent='已复制，可粘贴到编辑器的「个人简介」章节。';}catch{result.focus();result.select();status.textContent='已选中草稿，可使用键盘复制。';}});
</script>
