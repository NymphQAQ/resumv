---
import '../styles/global.css';
import '@fontsource-variable/tiktok-sans/wght.css';
import '../styles/typography.css';
import Icon from '../components/Icon.astro';
import GitHubLink from '../components/GitHubLink';
import ProjectFooter from '../components/ProjectFooter';
import Head from '../components/seo/Head.astro';
import '../styles/seo.css';
const {title = '简历模板、示例与求职工具', active = 'home', description = '免费制作和下载简历，浏览可编辑模板、各岗位的完整简历示例及写作指南。无需注册。', noindex = false, schema = []} = Astro.props;
const items = [
  ['home', '首页', '/', 'home'],
  ['builder', '简历编辑器', '/builder/', 'file'],
  ['templates', '简历模板', '/templates/', 'grid'],
  ['cover-letter', '求职信', '/cover-letter/', 'mail'],
  ['checker', '简历检查', '/checker/', 'check'],
  ['advice', '求职指南', '/advice/', 'spark'],
];
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#ffffff"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><Head title={title} description={description} noindex={noindex} schema={schema}/></head>
<body>
<a class="skip-link" href="#main">跳到主要内容</a>
<header class="header"><a class="brand" href="/" aria-label="Resumv 首页"><span class="brand-mark">r</span>resumv<span class="brand-dot">.</span></a><div class="header-actions"><GitHubLink client:load/><a class="my-docs" href="/documents/">我的文档</a><a class="button primary small" href="/builder/">创建简历 <span>+</span></a><button class="menu-toggle icon-button" aria-label="切换导航菜单" aria-expanded="false"><Icon name="menu"/></button></div></header>
<aside class="sidebar"><nav aria-label="主导航">{items.map(([key,name,url,icon])=><a href={url} class:list={['nav-item',{selected:active===key}]} aria-current={active===key?'page':undefined}><Icon name={icon}/><span>{name}</span></a>)}</nav><div class="sidebar-divider"></div><a class:list={['nav-item',{selected:active==='documents'}]} aria-current={active==='documents'?'page':undefined} href="/documents/"><Icon name="folder"/>我的文档</a><div class="sidebar-bottom"><a href="/about/">关于</a><a href="/privacy/">隐私</a><a href="/help/">帮助</a><a href="/editorial-policy/">编辑政策</a><a href="/contact/">联系我们</a><p>© {new Date().getFullYear()} resumv</p></div></aside>
<main id="main"><slot/><ProjectFooter client:load/></main><div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>import '../scripts/app.ts';</script>
</body></html>

