---
import Head from '../components/seo/Head.astro';
import ResumeBuilder from '../components/builder/ResumeBuilder';
import '@fontsource-variable/tiktok-sans/wght.css';
import '../styles/global.css';
import '../styles/typography.css';
const {kind='resume'}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><Head title={kind==='cv'?'履历编辑器':'简历编辑器'} description="在浏览器中编辑简历、自定义模板，可下载 PDF、Word、Markdown 或 JSON 备份。" noindex={true}/></head><body><ResumeBuilder kind={kind} client:only="react"><div slot="fallback" class="builder-loading">正在打开简历编辑器…</div></ResumeBuilder><noscript>请启用 JavaScript，以便在浏览器中保存和预览简历。</noscript></body></html>
