---
import Layout from '../layouts/Layout.astro';
import {templates} from '../data/content';
const {kind='resume'}=Astro.props;
const letter=kind==='letter';
const title=letter?'求职信':kind==='cv'?'履历':'简历';
---
<Layout noindex={true} title={`${title}编辑器`} active={letter?'cover-letter':'builder'}><div class="page-wrap editor-page" id="editor" data-kind={kind}>
<header class="page-heading"><div><h1>编辑{title}</h1><span id="save-status" class="save-status" role="status">更改会保存在当前浏览器</span></div><div class="export-group"><button class="button secondary" data-export="json">备份</button><button class="button secondary" data-export="txt">TXT</button><button class="button secondary" data-export="doc">Word</button><button class="button primary" data-export="pdf">PDF / 打印 ↓</button></div></header>
<div class="toolbar"><label class="field-label" style="margin:0;flex:1">文档名称<input class="field" data-field="title" placeholder={`未命名${title}`}/></label><label class="field-label" style="margin:0">模板<select class="field" data-field="template">{templates.map(t=><option value={t.id}>{t.name}</option>)}</select></label><label class="field-label" style="margin:0">强调色<input class="field" type="color" data-field="color" style="height:43px;width:66px;padding:6px"/></label></div>
<div class="editor-layout"><div class="editor-form">
<div class="editor-tabs" role="tablist" aria-label="文档章节">{(letter?['基本资料','求职信正文']:['基本资料','工作经历','教育经历','技能',...(kind==='cv'?['研究成果']:[])]).map((s,i)=><button id={`tab-${i}`} class:list={['editor-tab',{active:i===0}]} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${i}`} data-tab={i}>{s}</button>)}</div>
<section id="panel-0" class="editor-panel" role="tabpanel" aria-labelledby="tab-0"><h2>基本资料</h2><p class="hint">填写招聘方可以联系到你的信息。</p><div class="field-grid">{[['name','姓名','例如：张晓'],['role','职业头衔','例如：产品设计师'],['email','电子邮箱','alex@example.com'],['phone','联系电话','+1 555 010 1234'],['location','所在地','广东省深圳市'],['website','个人网站或 LinkedIn','linkedin.com/in/alexmorgan']].map(([key,label,placeholder])=><label class="field-label">{label}<input class="field" data-field={key} type={key==='email'?'email':'text'} placeholder={placeholder} maxlength="250"/></label>)}</div>{!letter&&<><label class="field-label">个人简介<textarea class="field" data-field="summary" rows="6" placeholder="用几句话介绍与你目标岗位相关的经历和擅长的领域。"></textarea></label><button id="suggest-summary" class="outline-button">添加写作模板</button><p class="hint">模板会使用填写的头衔与技能，请根据实际经历修改。</p></>}{letter&&<><label class="field-label">公司<input class="field" data-field="company" placeholder="申请的公司名称"/></label><label class="field-label">收件人<input class="field" data-field="recipient" placeholder="招聘负责人"/></label></>}</section>
{letter?<section id="panel-1" class="editor-panel" role="tabpanel" aria-labelledby="tab-1" hidden><h2>撰写求职信</h2><label class="field-label">求职信正文<textarea class="field" data-field="body" rows="18" placeholder="说明你为什么对这个岗位感兴趣，用一项相关成果展示匹配度，并在结尾表达沟通意愿。"></textarea></label><button id="suggest-letter" class="outline-button">添加求职信提纲</button><p class="hint">发送前请用你的实际信息替换方括号中的提示。</p></section>:<><section id="panel-1" class="editor-panel" role="tabpanel" aria-labelledby="tab-1" hidden><h2>工作经历</h2><p class="hint">从最近的职位写起，说明你做了什么以及取得的成果。</p><div id="experience-fields"></div><button class="outline-button" id="add-experience">+ 添加工作经历</button></section><section id="panel-2" class="editor-panel" role="tabpanel" aria-labelledby="tab-2" hidden><h2>教育经历</h2><div id="education-fields"></div><button class="outline-button" id="add-education">+ 添加教育经历</button></section><section id="panel-3" class="editor-panel" role="tabpanel" aria-labelledby="tab-3" hidden><h2>技能与补充信息</h2><label class="field-label">技能<textarea class="field" data-field="skills" rows="6" placeholder="用逗号分隔技能，例如：项目管理、Python、沟通协作"></textarea></label><label class="field-label">证书、语言能力与补充信息<textarea class="field" data-field="additional" rows="7" placeholder="填写相关的证书、语言能力、奖项或志愿服务经历。"></textarea></label></section>{kind==='cv'&&<section id="panel-4" class="editor-panel" role="tabpanel" aria-labelledby="tab-4" hidden><h2>研究成果</h2><label class="field-label">研究与出版物<textarea class="field" data-field="research" rows="12" placeholder="填写出版物标题、合著者、期刊、日期和相关研究项目。"></textarea></label></section>}</>}
<div class="editor-actions"><button id="previous-section" class="button secondary" disabled>← 上一节</button><button id="next-section" class="button primary">下一节 →</button></div>
</div><div class="preview-zone"><div class="preview-toolbar"><span>实时预览</span><span>A4 · <span id="preview-template">现代</span></span></div><article id="document-preview" class="document-preview" aria-label="文档预览"></article></div></div><div class="notice">文档保存在当前浏览器。可下载备份以便恢复或转移。导出 PDF 时，请在打印对话框中选择「另存为 PDF」并关闭页眉和页脚。</div>
</div></Layout>

